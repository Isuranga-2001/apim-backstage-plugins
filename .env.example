# LOCAL ENVIRONMENT SETUP INSTRUCTIONS:
# You have two options to provide these configurations in your local environment.
# Choose ONLY ONE of the following options (they are mutually exclusive):
# 
# Option 1 (Using .env):
#   Copy this file to .env:
#   cp .env.example .env
#   Then, fill in the actual values below.
#   To run the app with these variables, export them before starting:
#   export $(grep -v '^#' .env | xargs) && yarn start
#
# Option 2 (Using app-config.local.yaml):
#   Instead of using a .env file, you can copy app-config.local.yaml.example to app-config.local.yaml:
#   cp app-config.local.yaml.example app-config.local.yaml
#   Then, update the values directly in that YAML file.
# 
# -------------------------------------------------------------------------

# WSO2 API Manager Credentials
WSO2_CLIENT_ID=your_client_id_here
WSO2_CLIENT_SECRET=your_client_secret_here
WSO2_BASE_URL=https://127.0.0.1:9443
# TLS Configuration for local/self-signed certificates (set to false for local dev)
WSO2_TLS_REJECT_UNAUTHORIZED=false
WSO2_PUBLISHER_BASE_PATH=/api/am/publisher/v4
WSO2_DEVPORTAL_BASE_PATH=/api/am/devportal/v3
WSO2_SERVICE_CATALOG_BASE_PATH=/api/am/service-catalog/v1

# WSO2 API Portal Publishing
WSO2_API_PORTAL_ENABLED=false
WSO2_API_PORTAL_BASE_URL=https://devportal.preview-dv.bijira.dev


# WSO2 Platform Gateway Configuration
WSO2_GATEWAY_MANAGEMENT_API_USERNAME=admin
WSO2_GATEWAY_MANAGEMENT_API_PASSWORD=admin


# Catalog Providers
WSO2_APIM_USERNAME=admin
WSO2_APIM_PASSWORD=admin


# Ports
PORT=3000
BACKEND_PORT=7007


# Base URLs (Change these to your ngrok URLs or local IP when accessing from another device)
APP_BASE_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:7007


WSO2_SYNC_FREQUENCY_MINUTES=2
WSO2_SYNC_TIMEOUT_MINUTES=5
WSO2_SYNC_INITIAL_DELAY_SECONDS=15
WSO2_GATEWAY_SELF_HOSTED_URL=http://development-default.openchoreoapis.localhost:8080
WSO2_GATEWAY_MANAGEMENT_API_URL=http://development-default.openchoreoapis.localhost:9090/rest-apis
