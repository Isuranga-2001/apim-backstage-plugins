# LOCAL ENVIRONMENT SETUP INSTRUCTIONS:
# You have two options to provide these configurations in your local environment.
# Choose ONLY ONE of the following options (they are mutually exclusive):
# 
# Option 1 (Using app-config.local.yaml):
#   Copy this file to app-config.local.yaml:
#   cp app-config.local.yaml.example app-config.local.yaml
#   Then, update the values directly in this file. Backstage will automatically 
#   merge this file and override the variables defined in app-config.yaml.
#
# Option 2 (Using .env):
#   Instead of using this file, you can copy .env.example to .env:
#   cp .env.example .env
#   Then, provide the environment variables there.
# 
# -------------------------------------------------------------------------

app:
  baseUrl: http://localhost:3000

backend:
  baseUrl: http://localhost:7007
  listen:
    port: 7007
  cors:
    origin: http://localhost:3000

catalog:
  providers:
    wso2ApiPlatform:
      baseUrl: https://127.0.0.1:9443
      username: admin
      password: admin
      schedule:
        frequency:
          minutes: 20
        timeout:
          minutes: 5
        initialDelay:
          seconds: 15

wso2ApiPlatform:
  baseUrl: https://127.0.0.1:9443
  tls:
    rejectUnauthorized: false
  publisherBasePath: /api/am/publisher/v4
  developerBasePath: /api/am/devportal/v3
  serviceCatalogBasePath: /api/am/service-catalog/v1
  auth:
    clientId: your_client_id_here
    clientSecret: your_client_secret_here
    tokenUrl: https://127.0.0.1:9443/oauth2/token

# wso2ApiPlatformApiPortal is its own top-level block, not nested under
# wso2ApiPlatform — see plugins/wso2-api-platform-backend/README.md
# "API Portal publishing" for the full auth.idp.strategy reference.
wso2ApiPlatformApiPortal:
  enabled: true
  baseUrl: https://localhost:9543
  tls:
    rejectUnauthorized: false
  auth:
    mode: platform-login
    # mode: idp
    # idp:
    #   strategy: service-account # | manual | reuse-signin
    #   serviceAccount:
    #     tokenUrl: https://idp.example.com/oauth2/token
    #     clientId: your_m2m_client_id_here
    #     clientSecret: your_m2m_client_secret_here
    #     scope: 'dp:api:manage dp:api_content:manage dp:label:read dp:subscription_plan:read'
    #   reuseSignIn:
    #     providerId: oauth2
    #     scopes: ['dp:api:manage', 'dp:api_content:manage']

# Self-Hosted Gateway Configuration
wso2ApiPlatformGateway:
  enabled: true
  gateways:
    - name: Self-Hosted-1
      runtimeUrls:
        - http://development-default.openchoreoapis.localhost:8080
      managementApiUrl: http://development-default.openchoreoapis.localhost:9090/rest-apis
      managementApiUsername: admin
      managementApiPassword: admin
